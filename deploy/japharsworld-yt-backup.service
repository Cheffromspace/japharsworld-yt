[Unit]
Description=Daily backup to a private S3 bucket: events, metrics.db, Grafana-only series (Everything-is-OK#585)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jyt
Group=jyt
# Reads the search service's and the poller's journal (their events) without root.
SupplementaryGroups=systemd-journal
EnvironmentFile=/etc/japharsworld-yt.env
# The S3 key (write-only: PutObject under the prefix) and the Grafana read token: a root-only file (mode 600) that only
# this unit loads, not the search service's. The job runs as jyt, so jyt processes could read them from its environment
# while it runs; acceptable for a key that can only add objects.
EnvironmentFile=-/etc/japharsworld-yt-backup.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/japharsworld-yt/metrics/backup.js
TimeoutStartSec=30min
Nice=15
IOSchedulingClass=idle
MemoryMax=400M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# The state file, and the databases' -shm files (opened read only; WAL needs them).
ReadWritePaths=/var/lib/japharsworld-yt
