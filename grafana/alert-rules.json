[
 {
  "uid": "eiok-linode-silent",
  "title": "Linode sends nothing",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "5m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "No metrics from the Linode for 10 minutes: the server, Alloy or the exporter is down."
  },
  "labels": {
   "project": "everything-is-ok",
   "severity": "warning"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "absent_over_time(eiok_search_up{env!=\"staging\",host=\"linode\"}[10m])",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
