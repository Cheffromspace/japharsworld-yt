{"wireMagic": "pb3", "pens": [{}], "wsWinStyles": [{}], "wpWinPositions": [{}], "events": [{"tStartMs": 680, "dDurationMs": 3324, "segs": [{"utf8": "مرحباً، اسمي ساكورا من اليابانية في اليابان."}]}, {"tStartMs": 5004, "dDurationMs": 4337, "segs": [{"utf8": "اليوم أود أن أريكم كيف أقضي صباحات عطلتي."}]}, {"tStartMs": 9508, "dDurationMs": 4270, "segs": [{"utf8": "لقد أضفت ترجمة وترجمات يابانية."}]}, {"tStartMs": 14012, "dDurationMs": 4036, "segs": [{"utf8": "يرجى محاولة استخدامه كدراسة للغة اليابانية."}]}, {"tStartMs": 23000, "dDurationMs": 4989, "segs": [{"utf8": "استيقظت في الساعة 6 صباحًا في هذا اليوم."}]}, {"tStartMs": 27989, "dDurationMs": 4971, "segs": [{"utf8": "فتحت الستائر للحصول على بعض ضوء الشمس."}]}, {"tStartMs": 33000, "dDurationMs": 6719, "segs": [{"utf8": "السماء صافية ويمكنني رؤية سماء زرقاء جميلة من خلال النافذة."}]}, {"tStartMs": 39719, "dDurationMs": 5984, "segs": [{"utf8": "أرتدي النعال في المنزل."}]}, {"tStartMs": 46704, "dDurationMs": 6806, "segs": [{"utf8": "عندما أستيقظ، أشعل الضوء وأغسل يدي ووجهي."}]}, {"tStartMs": 55520, "dDurationMs": 5195, "segs": [{"utf8": "اغسل يديك بالصابون."}]}, {"tStartMs": 61683, "dDurationMs": 5277, "segs": [{"utf8": "في الشتاء يكون الأمر صعباً بعض الشيء لأن الجو بارد."}]}, {"tStartMs": 68021, "dDurationMs": 5499, "segs": [{"utf8": "بعد مسح يديك بالمنشفة، اغسل أسنانك بالفرشاة."}]}, {"tStartMs": 73720, "dDurationMs": 7311, "segs": [{"utf8": "سمعت أن الكثير من البكتيريا تتراكم في الأسنان ليلاً.\nسمعت أن هناك الكثير من البكتيريا تتراكم في الأسنان ليلاً."}]}, {"tStartMs": 81198, "dDurationMs": 4637, "segs": [{"utf8": "أنظف أسناني بالفرشاة مرة واحدة قبل تناول الفطور."}]}, {"tStartMs": 86836, "dDurationMs": 4704, "segs": [{"utf8": "أغسل أسناني بالفرشاة لمدة دقيقتين تقريباً."}]}, {"tStartMs": 92560, "dDurationMs": 5485, "segs": [{"utf8": "بعد تنظيف أسنانك بالفرشاة، قم بوزن نفسك على الميزان.\nقم بوزن نفسك على الميزان."}]}, {"tStartMs": 99046, "dDurationMs": 2669, "segs": [{"utf8": "وزني"}]}, {"tStartMs": 102015, "dDurationMs": 1701, "segs": [{"utf8": "إنه سر... (ضحك)"}]}, {"tStartMs": 104719, "dDurationMs": 6770, "segs": [{"utf8": "لا يزال الجو شتاءً في اليابان، لذا قمت بتشغيل مكيف الهواء."}]}, {"tStartMs": 112490, "dDurationMs": 4970, "segs": [{"utf8": "ثم أشرب كوباً من الماء."}]}, {"tStartMs": 118027, "dDurationMs": 4037, "segs": [{"utf8": "في اليابان، يمكنك شرب ماء الصنبور."}]}, {"tStartMs": 122100, "dDurationMs": 5902, "segs": [{"utf8": " المياه المعبأة في زجاجات مذاقها أفضل بعد كل شيء."}]}, {"tStartMs": 129570, "dDurationMs": 3803, "segs": [{"utf8": "أغير ملابسي للمشي"}]}, {"tStartMs": 134340, "dDurationMs": 6660, "segs": [{"utf8": "التوجه إلى حديقة تبعد مسافة قصيرة عن المنزل."}]}, {"tStartMs": 142213, "dDurationMs": 3136, "segs": [{"utf8": "لقد وصلنا إلى الحديقة!"}]}, {"tStartMs": 146350, "dDurationMs": 4904, "segs": [{"utf8": "أمارس المشي في الصباح عندما يكون لدي وقت."}]}, {"tStartMs": 152255, "dDurationMs": 4970, "segs": [{"utf8": "الجو جميل جداً اليوم."}]}, {"tStartMs": 158259, "dDurationMs": 7440, "segs": [{"utf8": "السماء زرقاء ويمكنك سماع زقزقة الطيور."}]}, {"tStartMs": 166699, "dDurationMs": 8774, "segs": [{"utf8": "لا يوجد الكثير من الناس في الصباح، لذا يمكنك أن تحظى بالمنتزه لوحدك."}]}, {"tStartMs": 176560, "dDurationMs": 11089, "segs": [{"utf8": "يوجد في اليابان أربعة فصول: الربيع، والصيف، والخريف، والشتاء."}]}, {"tStartMs": 189040, "dDurationMs": 10080, "segs": [{"utf8": "هذه الفصول الأربعة تسمى الفصول الأربعة أو الربيع والصيف والخريف والشتاء\nوالخريف والشتاء."}]}, {"tStartMs": 200093, "dDurationMs": 6104, "segs": [{"utf8": "في فصل الشتاء تكون الخضرة قليلة والمناظر الطبيعية موحشة."}]}, {"tStartMs": 207031, "dDurationMs": 7848, "segs": [{"utf8": "ولهذا السبب فإن الهواء نقي والسماء جميلة."}]}, {"tStartMs": 216005, "dDurationMs": 5738, "segs": [{"utf8": "بالمناسبة، أحب الخريف أكثر."}]}, {"tStartMs": 223745, "dDurationMs": 6972, "segs": [{"utf8": "والسبب في ذلك هو درجات الحرارة اللطيفة وتنوع الأطعمة الموسمية."}]}, {"tStartMs": 231751, "dDurationMs": 5204, "segs": [{"utf8": "ما هو المناخ في بلدك?"}]}, {"tStartMs": 237355, "dDurationMs": 4325, "segs": [{"utf8": "من فضلك أخبرنا في قسم التعليقات!"}]}]}