{"wireMagic": "pb3", "pens": [{}], "wsWinStyles": [{}, {"mhModeHint": 2, "juJustifCode": 0, "sdScrollDir": 3}], "wpWinPositions": [{}, {"apPoint": 6, "ahHorPos": 20, "avVerPos": 100, "rcRows": 2, "ccCols": 40}], "events": [{"tStartMs": 0, "dDurationMs": 1309415, "id": 1, "wpWinPosId": 1, "wsWinStyleId": 1}, {"tStartMs": 654, "dDurationMs": 2020, "wWinId": 1, "segs": [{"utf8": "[音楽]"}]}, {"tStartMs": 5789, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 5799, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "なんかさ、たまにメール来ない。なんか実況を始めたいと思ってるんですけど、どんなゲームやれば伸びますかみたいな。", "acAsrConf": 0}]}, {"tStartMs": 13310, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 13320, "dDurationMs": 4920, "wWinId": 1, "segs": [{"utf8": "いえ、どんなゲームから聞いてくんだ?", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 15230, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 15240, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "なんかそういう感じのメール。あ、来るでしょ、みんな。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 18710, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 18720, "dDurationMs": 4280, "wWinId": 1, "segs": [{"utf8": "たまにそういう感じのは来る。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 20429, "dDurationMs": 2571, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 20439, "dDurationMs": 2961, "wWinId": 1, "segs": [{"utf8": "いや、まあまあまあ、どうすればいいですか的なのはね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 22990, "dDurationMs": 410, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 23000, "dDurationMs": 2640, "wWinId": 1, "segs": [{"utf8": "そう、そう。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 23390, "dDurationMs": 2250, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 23400, "dDurationMs": 2560, "wWinId": 1, "segs": [{"utf8": "どんな機材使ってますかとか", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 25630, "dDurationMs": 330, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 25640, "dDurationMs": 2520, "wWinId": 1, "segs": [{"utf8": "ね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 25950, "dDurationMs": 2210, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 25960, "dDurationMs": 5200, "wWinId": 1, "segs": [{"utf8": "そうだね。", "acAsrConf": 0, "isSpeakerChange": 1}, {"utf8": "あるはあるけど", "tOffsetMs": 719, "acAsrConf": 0}]}, {"tStartMs": 28150, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 28160, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "相談してくれるのはありがたいんだけど、ま、それ欠かさず無視してるわけですよ、毎回。し、し、し", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 32740, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 32750, "dDurationMs": 2020, "wWinId": 1, "segs": [{"utf8": "[笑い]"}]}, {"tStartMs": 35869, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 35879, "dDurationMs": 2766, "wWinId": 1, "segs": [{"utf8": "うん。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 37069, "dDurationMs": 1576, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 37079, "dDurationMs": 2561, "wWinId": 1, "segs": [{"utf8": "無視してます。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 38635, "dDurationMs": 1005, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 38645, "dDurationMs": 3835, "wWinId": 1, "segs": [{"utf8": "[笑い]"}]}, {"tStartMs": 39630, "dDurationMs": 2850, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 39640, "dDurationMs": 4439, "wWinId": 1, "segs": [{"utf8": "いや、無視というか何も言えないんだよね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 42470, "dDurationMs": 1609, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 42480, "dDurationMs": 4599, "wWinId": 1, "segs": [{"utf8": "まあ、確かにね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 44069, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 44079, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "なんかそんなさ、人に教えるようなことはしてないし。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 48510, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 48520, "dDurationMs": 5400, "wWinId": 1, "segs": [{"utf8": "それが合うかわかんないからね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 50910, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 50920, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "俺からするとやっぱそういうのを調べることも大事っていうかさ。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 55430, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 55440, "dDurationMs": 2855, "wWinId": 1, "segs": [{"utf8": "まあそうだな。", "acAsrConf": 0}]}, {"tStartMs": 56630, "dDurationMs": 1665, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 56640, "dDurationMs": 3675, "wWinId": 1, "segs": [{"utf8": "そうそう。今日活動っていうか初めにおいて結構重要だと思うからさ。教えない方がいいと思うよね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 58285, "dDurationMs": 2030, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 58295, "dDurationMs": 2020, "wWinId": 1, "segs": [{"utf8": "[音楽]"}]}, {"tStartMs": 62229, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 62239, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "ま、昔の方がそういう情報少なかったりしたしね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 66190, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 66200, "dDurationMs": 5640, "wWinId": 1, "segs": [{"utf8": "うん。そうだね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 68830, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 68840, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "そう。俺よくしてる話だけどさ、最初にそのゲームをさ、キャプチャーする、録画する機材みたいなのさ、", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 75870, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 75880, "dDurationMs": 1360, "wWinId": 1, "segs": [{"utf8": "買った時にさ、", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 76789, "dDurationMs": 451, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 76799, "dDurationMs": 3441, "wWinId": 1, "segs": [{"utf8": "はい。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 77230, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 77240, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "なんかあのハードウェアエンコードっていうなんか仕様のやつでさ、もう絶対になんか", "acAsrConf": 0}]}, {"tStartMs": 83350, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 83360, "dDurationMs": 3280, "wWinId": 1, "segs": [{"utf8": "3", "acAsrConf": 0}, {"utf8": "秒ぐらい遅れて録画の映像が来るやつ。", "tOffsetMs": 280, "acAsrConf": 0}]}, {"tStartMs": 88789, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 88799, "dDurationMs": 1591, "wWinId": 1, "segs": [{"utf8": "あるある。うん。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 90030, "dDurationMs": 360, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 90040, "dDurationMs": 2370, "wWinId": 1, "segs": [{"utf8": "あれなんかあれ割と昔みんな失敗してたと思うけど", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 90380, "dDurationMs": 2030, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 90390, "dDurationMs": 2020, "wWinId": 1, "segs": [{"utf8": "[笑い]"}]}, {"tStartMs": 94389, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 94399, "dDurationMs": 1887, "wWinId": 1, "segs": [{"utf8": "あったな。そう。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 95550, "dDurationMs": 736, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 95560, "dDurationMs": 2746, "wWinId": 1, "segs": [{"utf8": "そういうさなんかそういう失敗みたいなね。あった。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 96276, "dDurationMs": 2030, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 96286, "dDurationMs": 2020, "wWinId": 1, "segs": [{"utf8": "[笑い]"}]}, {"tStartMs": 99550, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 99560, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "そうそうそう。そういう失敗を散々繰り返してきたもんね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 103870, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 103880, "dDurationMs": 5919, "wWinId": 1, "segs": [{"utf8": "うん。そうね。訪れチーンはね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 106789, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 106799, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "今でも訪れなんか苦しんでるもんな。", "acAsrConf": 0}]}, {"tStartMs": 110030, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 110040, "dDurationMs": 3439, "wWinId": 1, "segs": [{"utf8": "たまにあるね。", "acAsrConf": 0, "isSpeakerChange": 1}, {"utf8": "[笑い]", "tOffsetMs": 1311}]}, {"tStartMs": 112149, "dDurationMs": 1330, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 112159, "dDurationMs": 2041, "wWinId": 1, "segs": [{"utf8": "確か", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 113469, "dDurationMs": 731, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 113479, "dDurationMs": 3240, "wWinId": 1, "segs": [{"utf8": "苦しんでますね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 114190, "dDurationMs": 2529, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 114200, "dDurationMs": 5011, "wWinId": 1, "segs": [{"utf8": "未だに原因不明の訪れあったりする。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 116709, "dDurationMs": 2502, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 116719, "dDurationMs": 2680, "wWinId": 1, "segs": [{"utf8": "あるじゃん。後半になると遅れてくれるあるじゃん。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 119201, "dDurationMs": 198, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 119211, "dDurationMs": 1709, "wWinId": 1, "segs": [{"utf8": "[笑い]"}]}, {"tStartMs": 119389, "dDurationMs": 1531, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 119399, "dDurationMs": 4521, "wWinId": 1, "segs": [{"utf8": "あれ意味わかんないでしょ。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 120910, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 120920, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "うん。ちょっとずつね、手作業補正すんのね。なってるわ。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 125510, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 125520, "dDurationMs": 1680, "wWinId": 1, "segs": [{"utf8": "そう。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 125830, "dDurationMs": 1370, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 125840, "dDurationMs": 3520, "wWinId": 1, "segs": [{"utf8": "原因わかんないですね。", "acAsrConf": 0, "isSpeakerChange": 1}, {"utf8": "5", "tOffsetMs": 1199, "acAsrConf": 0}]}, {"tStartMs": 127190, "dDurationMs": 2170, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 127200, "dDurationMs": 3520, "wWinId": 1, "segs": [{"utf8": "分に", "acAsrConf": 0, "isSpeakerChange": 1}, {"utf8": "1", "tOffsetMs": 279, "acAsrConf": 0}, {"utf8": "回ぐらいなんかさ、", "tOffsetMs": 400, "acAsrConf": 0}, {"utf8": "0.1", "tOffsetMs": 1559, "acAsrConf": 0}]}, {"tStartMs": 129350, "dDurationMs": 1370, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 129360, "dDurationMs": 2360, "wWinId": 1, "segs": [{"utf8": "秒ぐらいずらしてさ。", "acAsrConf": 0}]}, {"tStartMs": 130710, "dDurationMs": 1010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 130720, "dDurationMs": 2280, "wWinId": 1, "segs": [{"utf8": "そうそうそうそうそう。", "acAsrConf": 0, "isSpeakerChange": 1}, {"utf8": "[笑い]", "tOffsetMs": 281}]}, {"tStartMs": 131710, "dDurationMs": 1290, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 131720, "dDurationMs": 2680, "wWinId": 1, "segs": [{"utf8": "やってるやってる。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 132990, "dDurationMs": 1410, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 133000, "dDurationMs": 2040, "wWinId": 1, "segs": [{"utf8": "やるよね、その作業。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 134390, "dDurationMs": 650, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 134400, "dDurationMs": 3640, "wWinId": 1, "segs": [{"utf8": "うん。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 135030, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 135040, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "確かにそういうのはでも自分でなんとかしてきてるよね。今まで誰かに聞かずにね。", "acAsrConf": 0}]}, {"tStartMs": 139910, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 139920, "dDurationMs": 880, "wWinId": 1, "segs": [{"utf8": "うん。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 140150, "dDurationMs": 650, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 140160, "dDurationMs": 2439, "wWinId": 1, "segs": [{"utf8": "まあね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 140790, "dDurationMs": 1809, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 140800, "dDurationMs": 3600, "wWinId": 1, "segs": [{"utf8": "ま、そうだね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 142589, "dDurationMs": 1811, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 142599, "dDurationMs": 2081, "wWinId": 1, "segs": [{"utf8": "逆に自分がい。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 144390, "dDurationMs": 290, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 144400, "dDurationMs": 2040, "wWinId": 1, "segs": [{"utf8": "うん。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 144670, "dDurationMs": 1770, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 144680, "dDurationMs": 2041, "wWinId": 1, "segs": [{"utf8": "はい。すいません。かぶっちゃって。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 146430, "dDurationMs": 291, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 146440, "dDurationMs": 2301, "wWinId": 1, "segs": [{"utf8": "はい。えい。でも薄っぺいこと言っただけだから俺は。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 146711, "dDurationMs": 2030, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 146721, "dDurationMs": 2020, "wWinId": 1, "segs": [{"utf8": "[笑い]"}]}, {"tStartMs": 151949, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 151959, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "え、逆にさ、最初自分が始めた時、もう最初からさ、なんかめっちゃトップになろうみたいな感じのこと思ってた。", "acAsrConf": 0}]}, {"tStartMs": 158501, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 158511, "dDurationMs": 2020, "wWinId": 1, "segs": [{"utf8": "[音楽]"}]}, {"tStartMs": 160910, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 160920, "dDurationMs": 3399, "wWinId": 1, "segs": [{"utf8": "いやいやいやいやいや。そう、", "acAsrConf": 0, "isSpeakerChange": 1}, {"utf8": "[笑い]", "tOffsetMs": 211}]}, {"tStartMs": 162830, "dDurationMs": 1489, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 162840, "dDurationMs": 3960, "wWinId": 1, "segs": [{"utf8": "なんか違う話始、", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 164309, "dDurationMs": 2491, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 164319, "dDurationMs": 5481, "wWinId": 1, "segs": [{"utf8": "違う話だった。やり方じゃなくてこ", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 166790, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 166800, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "す。や、すげえやる気ある人からなんかメール来たりすんのよ。だって俺最近来たメールがさ、本気でトップ狙ってるんでコラボしてくださいみたいな。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 175869, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 175879, "dDurationMs": 2337, "wWinId": 1, "segs": [{"utf8": "待って、待って、待っ。俺、俺んとこにもそれ来たぜ。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 176186, "dDurationMs": 2030, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 176196, "dDurationMs": 2020, "wWinId": 1, "segs": [{"utf8": "[笑い]"}]}, {"tStartMs": 178309, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 178319, "dDurationMs": 3640, "wWinId": 1, "segs": [{"utf8": "あ、同じだ。同じ人だね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 181190, "dDurationMs": 769, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 181200, "dDurationMs": 3759, "wWinId": 1, "segs": [{"utf8": "本気でやってます。", "acAsrConf": 0}]}, {"tStartMs": 181949, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 181959, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "なんだ、俺だけじゃねえのかよ、あいつ。あ、見た、見たぞ。ああ、なるほどなるほど。そういうことね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 187470, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 187480, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "俺、俺に来たメールはね、てっぺんって書いてあったからね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 190597, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 190607, "dDurationMs": 2233, "wWinId": 1, "segs": [{"utf8": "[笑い]"}]}, {"tStartMs": 191509, "dDurationMs": 1331, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 191519, "dDurationMs": 4321, "wWinId": 1, "segs": [{"utf8": "同じ人かもしれんけど。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 192830, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 192840, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "同じ人かもしれかもしれけど、そのぐらいなんかさ、なんかめっちゃやる気ある", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 199350, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 199360, "dDurationMs": 920, "wWinId": 1, "segs": [{"utf8": "うん。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 199949, "dDurationMs": 331, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 199959, "dDurationMs": 3321, "wWinId": 1, "segs": [{"utf8": "うん。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 200270, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 200280, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "なんか感じでやってる人もさ、今多分", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 203990, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 204000, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "昔より弱いんじゃない?", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 207149, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 207159, "dDurationMs": 3640, "wWinId": 1, "segs": [{"utf8": "昔は。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 207789, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 207799, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "だから結局のところさ、趣味だわけじゃん。", "acAsrConf": 0}]}, {"tStartMs": 210949, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 210959, "dDurationMs": 3200, "wWinId": 1, "segs": [{"utf8": "そう、", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 211149, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 211159, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "ゲーム実況でも今もさ、なんつうの、商売にもなるしなんかある意味もう夢みたいなもんだよね。ゲーム者で食べていくっての。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 219110, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 219120, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "うん。そう、そう。だからこれは本当に別に馬鹿にしてるわけじゃなくて熱量すげえなって本当に", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 224670, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 224680, "dDurationMs": 4240, "wWinId": 1, "segs": [{"utf8": "なんか思うんだよね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 225910, "dDurationMs": 3010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 225920, "dDurationMs": 3000, "wWinId": 1, "segs": [{"utf8": "そう。そう。プロ野球選手とかサッカー選手みたいなもんだよ、ある意味。え、", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 229990, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 230000, "dDurationMs": 2319, "wWinId": 1, "segs": [{"utf8": "ね、", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 230630, "dDurationMs": 1689, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 230640, "dDurationMs": 3679, "wWinId": 1, "segs": [{"utf8": "プロゲーマーがいるからね。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 232309, "dDurationMs": 2010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 232319, "dDurationMs": 3483, "wWinId": 1, "segs": [{"utf8": "そう、そう、そう、そう、そう、そう。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 234309, "dDurationMs": 1493, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 234319, "dDurationMs": 2280, "wWinId": 1, "segs": [{"utf8": "うん。", "acAsrConf": 0, "isSpeakerChange": 1}]}, {"tStartMs": 235792, "dDurationMs": 807, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 235802, "dDurationMs": 2558, "wWinId": 1, "segs": [{"utf8": "[笑い]"}]}, {"tStartMs": 236589, "dDurationMs": 1771, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 236599, "dDurationMs": 3761, "wWinId": 1, "segs": [{"utf8": "そんな熱量はないよ。でも", "acAsrConf": 0}]}, {"tStartMs": 238350, "dDurationMs": 2010, "wWinId": 1, "aAppend": 1, "segs": [{"utf8": "\n"}]}, {"tStartMs": 238360, "dDurationMs": 3840, "wWinId": 1, "segs": [{"utf8": "10", "acAsrConf": 0}, {"utf8": "年前の俺ね、やっぱ", "tOffsetMs": 159, "acAsrConf": 0}]}]}