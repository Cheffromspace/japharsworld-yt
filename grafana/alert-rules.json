 {
  "uid": "eiok-checks-waiting",
  "title": "Flash checks waiting",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "5m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "A new/candidate/manual resolution or flash job has waited over 2 hours, or the daily batch over 5 hours; the Optiplex worker runs every 20 minutes, 6 jobs a run."
  },
  "labels": {
   "project": "everything-is-ok"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "max(eiok_jobs_oldest_pending_seconds{reason=\"other\"}) > 7200 or max(eiok_jobs_oldest_pending_seconds{reason=\"daily\"}) > 18000",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
  "uid": "eiok-home-cap",
  "title": "Home relay near its daily cap",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "5m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "The home relay has used 90 % of HOME_DAILY_MB today; at the cap, long videos go to Tunelio (credits) or youtube.com instead."
  },
  "labels": {
   "project": "everything-is-ok"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "max(eiok_home_today{key=\"mb\"}) / max(eiok_home_today{key=\"cap_mb\"}) >= 0.9",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
  "uid": "eiok-home-worker",
