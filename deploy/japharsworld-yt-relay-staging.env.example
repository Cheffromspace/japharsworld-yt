# /etc/japharsworld-yt-relay-staging.env on the Optiplex (root 0600): the staging relay worker (#160).
# Copy /etc/japharsworld-yt-relay.env, then change these. Owner 2026-10-26: shared settings and keys, same caps.
RELAY_URL=https://staging-yt.eiok.cc
# The same token as production (the staging server copies prod's env): during a DNS flip the production worker's
# RELAY_URL resolves to staging, and a different token would get 401s.
RELAY_TOKEN=
WORKER_NAME=optiplex-staging
# The stream cache and RELAY_MEDIA_MAX stay at their defaults (owner, 2026-10-26: the same limits as production). The
# unit's own CacheDirectory keeps the two caches apart: production's is on the media volume, staging's on / (40 GB of
# the 76 GB free, 2026-10-26).
