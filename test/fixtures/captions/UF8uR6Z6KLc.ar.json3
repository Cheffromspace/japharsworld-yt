{"wireMagic": "pb3", "pens": [{}], "wsWinStyles": [{}], "wpWinPositions": [{}], "events": [{"tStartMs": 6048, "dDurationMs": 1002, "segs": [{"utf8": "جامعة ستانفورد \nwww.stanford.edu"}]}, {"tStartMs": 7050, "dDurationMs": 5981, "segs": [{"utf8": "هذا البرنامج يأتيكم من جامعة ستانفورد , رجاءاً زورونا على الموقع اعلاه"}]}, {"tStartMs": 15005, "dDurationMs": 6048, "segs": [{"utf8": "تصفيق"}]}, {"tStartMs": 21053, "dDurationMs": 1031, "segs": [{"utf8": "أشكركم"}]}, {"tStartMs": 24096, "dDurationMs": 1985, "segs": [{"utf8": "(ستيف جوبز - الرئيس التنفيذي لشركة أبل و شركة بيكسار)"}]}, {"tStartMs": 27003, "dDurationMs": 5009, "segs": [{"utf8": "اتشرف بلقائي بكم اليوم لبدئكم في جامعة من اعرق جامعات العالم"}]}, {"tStartMs": 32012, "dDurationMs": 3042, "segs": [{"utf8": "هتاف"}]}, {"tStartMs": 36004, "dDurationMs": 9053, "segs": [{"utf8": "في الحقيقة  , انا لم اتخرج ابدا من الجامعه وهذا هو أقرب شيء حصلت عليه كخريج جامعة."}]}, {"tStartMs": 46009, "dDurationMs": 1087, "segs": [{"utf8": "[ضحك]"}]}, {"tStartMs": 48014, "dDurationMs": 6012, "segs": [{"utf8": "اليوم, أريد ان اخبركم بثلاث قصص من حياتي.\nهذا هو لا شيء كبير فقط ثلاث قصص."}]}, {"tStartMs": 55061, "dDurationMs": 3942, "segs": [{"utf8": "القصة الأولى عن ربط النقاط."}]}, {"tStartMs": 60071, "dDurationMs": 7948, "segs": [{"utf8": "انسحبت من جامعة ريد بعد أول ستة أشهر , ثم بقيت في انخفاض حوالي ثمانية عشر شهراً  أو نحو ذلك ,قبل أن استقيل فعلاً."}]}, {"tStartMs": 69040, "dDurationMs": 1043, "segs": [{"utf8": "السؤال لماذا انسحبت ؟"}]}, {"tStartMs": 72017, "dDurationMs": 1077, "segs": [{"utf8": "ابتدأ هذا كله قبل أن اولد"}]}, {"tStartMs": 75010, "dDurationMs": 6017, "segs": [{"utf8": "كانت امي البيولوجية شابة  متخرجة عزباء , و قررت وضعي للتبني."}]}, {"tStartMs": 82009, "dDurationMs": 3079, "segs": [{"utf8": "شعرت بقوة بأنه علي أن أتبنى من قبل خريجي جامعات,"}]}, {"tStartMs": 86011, "dDurationMs": 4055, "segs": [{"utf8": "لذلك كل شي كان معدّ لي لأُتبنى عند الولادة من قبل محامي وزوجته."}]}, {"tStartMs": 91073, "dDurationMs": 4981, "segs": [{"utf8": "إلا انه لحظة خروجي  وفي الدقيقة الأخيرة قرر الزوجان أنهما يريدان فتاة."}]}, {"tStartMs": 97082, "dDurationMs": 4952, "segs": [{"utf8": "حتى حصل والداي, اللذين كانوعلى لائحة الإنتظار , على مكالمة في منتصف الليل يسأل :"}]}, {"tStartMs": 103018, "dDurationMs": 6002, "segs": [{"utf8": "واضاف \"لقد حصلنا على طفل رضيع غير متوقع، هل تريده ؟\" قالوا: \"بالطبع\"."}]}, {"tStartMs": 110085, "dDurationMs": 7939, "segs": [{"utf8": "اكتشفت أمي البيولوجيه لاحقاً أن أمي بالتبني لم تتخرج قط من أي جامعة و أبي لم يتخرج من المدرسة الثانوية."}]}, {"tStartMs": 119000, "dDurationMs": 2077, "segs": [{"utf8": "رفضت حينها ان توقع أوراق التبني الأخيرة."}]}, {"tStartMs": 123027, "dDurationMs": 8040, "segs": [{"utf8": "بعد بضعة أشهر أذعنت للأمرعندما قطع والداي بالتبني عهداُ بأن أذهب للجامعة. وهذه كانت بداية حياتي."}]}, {"tStartMs": 133064, "dDurationMs": 7981, "segs": [{"utf8": "وبعد مضي سبعة عشر عاماً ذهبت فعلاً للجامعة. ولكن بسذاجة اخترت جامعة مكلفة مثل جامعة ستانفورد,"}]}, {"tStartMs": 142020, "dDurationMs": 4038, "segs": [{"utf8": "وكانت كل مدخرات والداي ذوي الطبقة العاملة تنفق على رسم التعليم الجامعي الخاص بي."}]}, {"tStartMs": 147055, "dDurationMs": 2962, "segs": [{"utf8": "وبعد ستة أشهر , لم أعد أستطيع رؤية الفائدة من ذلك."}]}, {"tStartMs": 150070, "dDurationMs": 5004, "segs": [{"utf8": "لم تكن لديّ فكرة عما أريد فعله في حياتي و لا كيف ستساعدني الجامعة على اكتشاف ذلك."}]}, {"tStartMs": 156073, "dDurationMs": 4012, "segs": [{"utf8": "وهنا كنت قد أنفقت كل مدخرات والداي التي جمعوها طيلة حياتهم."}]}, {"tStartMs": 162047, "dDurationMs": 4032, "segs": [{"utf8": "لذلك قررت الإنسحاب ووثقت بأن كل شي سيكون جيد."}]}, {"tStartMs": 167040, "dDurationMs": 4984, "segs": [{"utf8": "لقد كان جميل ومخيف في نفس الوقت, ولكن بالنظر للخلف فقد كانت احدى أفضل خياراتي التي قمت بها."}]}, {"tStartMs": 172093, "dDurationMs": 1006, "segs": [{"utf8": "[ضحك]"}]}, {"tStartMs": 174006, "dDurationMs": 5001, "segs": [{"utf8": "في اللحظة التي انسحبت بها استطعت التوقف عن أخذ الصفوف التي لم تكن تهمني,"}]}, {"tStartMs": 179050, "dDurationMs": 4000, "segs": [{"utf8": "ولبدء في الوقوع على تلك التي تهمني أكثر."}]}, {"tStartMs": 184057, "dDurationMs": 9025, "segs": [{"utf8": "لم تكن جميعها ذات طابع رومانسي. لم تكن لدي غرفة نوم , كنت انام على الأرض في غرف الأصدقاء , وبادلت زجاجات الكوكاكولا بـ 5 سنتات لشراء الطعام بها,"}]}, {"tStartMs": 194039, "dDurationMs": 6992, "segs": [{"utf8": "وكنت قادر على المشي سبعة أميال عبر المدينة كل ليلة أحد للحصول على وجبة واحدة جيدة  في معبد هاري كريشنا."}]}, {"tStartMs": 201094, "dDurationMs": 1926, "segs": [{"utf8": "احب ذلك"}]}, {"tStartMs": 203067, "dDurationMs": 6005, "segs": [{"utf8": "وكثير من الأشياء التي تعثرت بها عن طريق اتباع حدسي وفضولي تبينت لي فيما بعد بانها عديمة القيمة"}]}, {"tStartMs": 210012, "dDurationMs": 1023, "segs": [{"utf8": "و مثال على ذلك :"}]}, {"tStartMs": 212075, "dDurationMs": 5005, "segs": [{"utf8": "جامعة ريد في ذلك الوقت عرضت افضل خطّ يد تعليمي في المدينة"}]}, {"tStartMs": 218025, "dDurationMs": 6038, "segs": [{"utf8": "في كل مكان في الحرم الجامعي وفي كل ملصق , وفي كل درج , كان جميلاً خطّ اليد."}]}, {"tStartMs": 225016, "dDurationMs": 7032, "segs": [{"utf8": "و لأنني انسحبت ولم آخذ الصفوف العادية , قررت الالتحاق بصفوف تعلم الخطّ ."}]}, {"tStartMs": 232087, "dDurationMs": 6941, "segs": [{"utf8": "تعلمت عن الط الرقيق و بدون المحارف الرقيقه, وعن تفاوت المسافة بين الحروف المختلفة,"}]}, {"tStartMs": 239070, "dDurationMs": 2965, "segs": [{"utf8": "وحلول مايجعل الطباعة العظيمة عظيمة ."}]}]}