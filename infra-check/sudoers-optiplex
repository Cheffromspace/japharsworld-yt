# /etc/sudoers.d/yt-infra-check on the Optiplex (gameserver)
# The only root actions the weekly check may take here without a password: the maintenance in claude/monitoring.md
# ("Weekly infra check"), which it runs only when / is 85 % used or more, and the read-only security checks of
# infra-check/prompt.md (owner, 2026-10-26). No restarts (owner, 2026-10-25).
Cmnd_Alias YT_SAFE = \
  /usr/bin/journalctl --vacuum-size=500M, \
  /usr/sbin/logrotate -f /etc/logrotate.conf
Cmnd_Alias YT_READ = \
  /usr/sbin/sshd -T, \
  /usr/sbin/ufw status verbose, \
  /usr/bin/ss -tlnp
jonflatt ALL=(root) NOPASSWD: YT_SAFE, YT_READ
