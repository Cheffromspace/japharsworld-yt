   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "(sum(increase(eiok_events_total{env!=\"staging\",metric=\"credits\"}[3d])) / 3) * (days_in_month() - day_of_month() + 1) - max(eiok_credits_remaining{env!=\"staging\"}) > 0",
