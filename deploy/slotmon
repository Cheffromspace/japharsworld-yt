#!/bin/bash
# /usr/local/bin/slotmon: run the monitor CLI with its settings, as the service user. The PC worker calls this over SSH.
# KEY=VALUE lines read as systemd's EnvironmentFile reads them, never run as shell code: an unquoted DISCORD_MENTION=<@id>
# is a redirection to bash, a syntax error that dropped every line after it (#246, 2026-10-26). One pair of outer quotes
# is removed, nothing is expanded.
load_env() {
  local line key val
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
    key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
    if [[ "$val" =~ ^\"(.*)\"$ || "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"; fi
    export "$key=$val"
  done < "$1"
}
load_env /etc/japharsworld-yt-monitor.env
export HOME=/var/lib/japharsworld-yt-monitor
cd /opt/japharsworld-yt/monitor
PY=/opt/japharsworld-yt-monitor-venv/bin/python
[ "$(id -u)" = 0 ] && exec runuser -u jyt -- env HOME="$HOME" "$PY" -m slotmon "$@"
exec "$PY" -m slotmon "$@"
