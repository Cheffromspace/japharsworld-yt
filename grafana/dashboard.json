        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "id": 12,
   "title": "Start-up problems, last 3 h",
   "description": "Last 3 h, per ticket request: a slow video the player retries counts several timeouts. A timeout means the player waited 90 s and got youtube.com at 360p.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 9,
    "y": 5,
    "w": 7,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(increase(eiok_events_total{metric=\"ticket_timeout\"}[3h])) or vector(0)",
     "legendFormat": "player timeouts",
     "instant": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(increase(eiok_events_total{metric=\"build\",key=\"failed\"}[3h])) or vector(0)",
     "legendFormat": "failed builds",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#9ece6a",
        "value": null
       },
       {
        "color": "#e0af68",
        "value": 0.5
       },
       {
        "color": "#f7768e",
        "value": 3
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "id": 13,
   "title": "Tunelio build time",
   "description": "Visitors’ progressive builds (p95 over 3 h, from the daily buckets) and the speed probe’s latest start times (src/probe.js). Over ~20 s the visitor waits past the resolver hold; over ~100 s the player gives up.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 16,
    "y": 5,
    "w": 8,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (increase(eiok_build_progressive_seconds_bucket[3h])))",
     "legendFormat": "visitors p95, 3 h",
     "instant": true
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(eiok_poll{source=\"tunelio:progressive\",metric=\"start_s\"})",
     "legendFormat": "probe progressive",
     "instant": true
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(eiok_poll{source=\"tunelio:hls\",metric=\"start_s\"})",
     "legendFormat": "probe HLS",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 0,
     "mappings": [
      {
       "type": "special",
       "options": {
        "match": "nan",
        "result": {
         "text": "no builds"
        }
       }
      },
      {
       "type": "special",
       "options": {
        "match": "null",
        "result": {
         "text": "no builds"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#9ece6a",
        "value": null
       },
       {
        "color": "#e0af68",
        "value": 20
       },
       {
        "color": "#f7768e",
        "value": 60
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "row",
   "id": 14,
   "title": "Visitors and search",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "id": 15,
   "title": "In world (production)",
   "description": "VRChat’s world counts, polled about every minute (japharsworld-yt-occupants.timer). VRChat updates them on its own schedule.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(eiok_poll{source=\"world:prod\",metric=\"occupants\"})",
     "legendFormat": "in world"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(eiok_poll{source=\"world:prod\",metric=\"publicOccupants\"})",
     "legendFormat": "public instances"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(eiok_poll{source=\"world:prod\",metric=\"privateOccupants\"})",
     "legendFormat": "private instances"
    },
    {
     "refId": "D",
