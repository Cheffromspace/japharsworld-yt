// Grafana Alloy on the Linode (claude/monitoring.md). Installed by deploy/alloy-setup.sh linode.
// Metrics only: the exporter's usage and Channels numbers, host metrics, and probes of the public endpoints.
// No logs leave the server (privacy policy: logs stay on the one server).

prometheus.remote_write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_PROM_URL")
    basic_auth {
      username = sys.env("GRAFANA_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
  external_labels = { host = "linode" }
}

prometheus.scrape "eiok" {
  targets         = [{ "__address__" = "127.0.0.1:9464", "job" = "eiok" }]
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.cloud.receiver]
}

prometheus.exporter.unix "host" {
  disable_collectors = ["ipvs", "btrfs", "infiniband", "xfs", "zfs", "thermal_zone"]
  enable_collectors  = ["systemd", "textfile"]
  // deploy/deploy-record.sh writes the deploy markers here.
  textfile {
    directory = "/var/lib/japharsworld-yt-deploy"
  }
  systemd {
    unit_include = "(japharsworld-yt.*|bgutil-pot|caddy)\\.(service|timer)"
  }
}
prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.host.receiver]
}
// Keep the series the dashboard uses (the free tier counts active series).
prometheus.relabel "host" {
  rule {
    source_labels = ["__name__"]
    regex         = "node_(cpu_seconds_total|load1|load5|memory_MemAvailable_bytes|memory_MemTotal_bytes|filesystem_avail_bytes|filesystem_size_bytes|network_(receive|transmit)_bytes_total|boot_time_seconds|systemd_unit_state|time_seconds|uname_info)|eiok_deploy_timestamp_seconds"
    action        = "keep"
  }
  forward_to = [prometheus.remote_write.cloud.receiver]
}

prometheus.exporter.blackbox "public" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 10s, http: { preferred_ip_protocol: ip4 } } } }"
  target {
    name    = "search-healthz"
    address = "https://yt.japharsworld.com/healthz"
    module  = "http_2xx"
  }
  target {
    name    = "pages-sleep-list"
    address = "https://cheffromspace.github.io/japharsworld-yt/sleep-list.json"
    module  = "http_2xx"
  }
}
prometheus.scrape "public" {
  targets         = prometheus.exporter.blackbox.public.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.cloud.receiver]
}
