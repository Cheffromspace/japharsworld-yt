[Unit]
Description=Daily S3 backup at 01:30 Chicago, after the reporting day ends (Everything-is-OK#585)

[Timer]
OnCalendar=*-*-* 01:30:00 America/Chicago
RandomizedDelaySec=10min
# A night the Linode was down runs at boot; the job itself catches up to BACKUP_MAX_DAYS missed days.
Persistent=true

[Install]
WantedBy=timers.target
