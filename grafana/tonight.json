  {
   "type": "row",
   "id": 11,
   "title": "Who, broadly",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "id": 12,
   "title": "Here lately",
   "description": "One square per VRChat client language with joins in the last 2 hours (whatever the time range), from visitors who allow untrusted URLs: the bare search address the world loads once after join. It counts arrivals, not who is still here, so a square stays for 2 h after its last join. 1 join dark, 2–3 blue, 4 or more purple.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (key) (round(increase(eiok_events_total{env!=\"staging\",metric=\"join_lang\"}[2h]))) > 0",
     "legendFormat": "{{key}}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "name",
    "orientation": "vertical",
    "wideLayout": false,
    "text": {
     "titleSize": 26
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#414868",
        "value": null
       },
       {
        "color": "#7aa2f7",
        "value": 2
       },
       {
        "color": "#bb9af7",
        "value": 4
       }
      ]
     },
     "noValue": "no joins in 2 h 🌙"
    },
    "overrides": []
   }
  },
