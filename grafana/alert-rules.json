 {
  "uid": "eiok-search-down",
  "title": "Search service down",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "5m",
  "noDataState": "OK",
  "execErrState": "Error",
