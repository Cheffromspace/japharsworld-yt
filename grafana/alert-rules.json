 {
  "uid": "eiok-cert-expiry",
  "title": "TLS certificate expiring",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "60m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "A public certificate has under 14 days left ({{ $labels.job }}); Caddy should have renewed it at 30. Check `journalctl -u caddy` on the Linode."
  },
  "labels": {
   "project": "everything-is-ok",
   "severity": "warning"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "14 - min by (job) (probe_ssl_earliest_cert_expiry{env!=\"staging\",job=~\".*(search|short)-healthz.*\"} - time()) / 86400",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
  "uid": "eiok-domain-expiry",
  "title": "Domain expires within 30 days",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "60m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "{{ $labels.source }} expires within 30 days. The world bakes it: renew it at the registrar (Cloudflare for eiok.cc)."
  },
  "labels": {
   "project": "everything-is-ok",
   "severity": "warning"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "30 - min by (source) (eiok_poll{env!=\"staging\",source=~\"domain:.*\",metric=\"expires\"} - time()) / 86400",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
