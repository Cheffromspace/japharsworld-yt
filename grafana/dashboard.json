   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#7aa2f7",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "id": 6,
   "title": "Credits left",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(eiok_credits_remaining)",
     "legendFormat": "",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#f7768e",
        "value": null
       },
       {
        "color": "#e0af68",
        "value": 500
       },
       {
        "color": "#9ece6a",
        "value": 1500
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "id": 7,
   "title": "Channels hidden",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 15,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(eiok_slot_hidden * on(slot) (1 - eiok_slot_spare))",
     "legendFormat": "",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#9ece6a",
        "value": null
       },
       {
        "color": "#e0af68",
        "value": 1
       },
       {
        "color": "#f7768e",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "id": 8,
   "title": "Flash fails now",
   "description": "Slots whose current stream failed its last flash check.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "count(eiok_slot_flash_pass == 0) or vector(0)",
     "legendFormat": "",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#9ece6a",
        "value": null
       },
       {
        "color": "#f7768e",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "id": 9,
   "title": "Oldest waiting check",
   "description": "Resolution + flash jobs wait for the Optiplex worker (every 20 min).",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 21,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(eiok_jobs_oldest_pending_seconds)",
     "legendFormat": "",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#9ece6a",
        "value": null
       },
       {
        "color": "#e0af68",
        "value": 3600
       },
       {
        "color": "#f7768e",
        "value": 7200
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "id": 10,
   "title": "Total visits (production)",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 5,
