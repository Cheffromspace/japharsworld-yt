[Unit]
Description=japharsworld-yt search relay worker (outbound only: long-polls yt.japharsworld.com, never listens)
After=network-online.target
Wants=network-online.target

[Service]
User=jytrelay
Group=jytrelay
WorkingDirectory=/opt/japharsworld-yt-relay
EnvironmentFile=/etc/japharsworld-yt-relay.env
ExecStart=/usr/bin/node /opt/japharsworld-yt-relay/relay/worker.js
# The worker's cache of finished home relay streams (relay/cache.js), writable despite ProtectSystem=strict. A bigger
# volume can be mounted at /var/cache/japharsworld-yt-relay (README, home relay cache).
CacheDirectory=japharsworld-yt-relay
# The throwaway account's cookies.txt (Everything-is-OK#575, relay/cookies.js), mode 600, jytrelay's only.
StateDirectory=japharsworld-yt-relay
StateDirectoryMode=0700
Restart=always
RestartSec=5
# Memory: 300M at first (2026-10-18), 1G from 2026-10-24 (at 300M the worker swapped and its cgroup hit the limit all the
# time: the cgroup counts the stream cache's page cache, which the kernel reclaims at the limit), 4G from 2026-11-21
# (Everything-is-OK#968, the owner's go). On 2026-11-21 at 16:12Z the worker died at V8's own heap limit (about 550 MB,
# sized by Node from the 1G cgroup) parsing a huge caption info JSON; relay/captions.js now refuses such files unread.
# The heap is set here rather than left to Node's guess from the cgroup: 2 GB old space, about 4x what it had, and the
# other ~2 GB of the cap stay for yt-dlp (Python), ffmpeg, buffers and page cache, so the heap limit is met before the
# cgroup's. Set through NODE_OPTIONS, not ExecStart, which the Alloy memory matcher reads (#967); child node processes
# (yt-dlp's --js-runtimes node) inherit the same ceiling, a limit and not a reservation. The Optiplex has 31 GB (about
# 25 GB free, 2026-11-21); all the capped units together come to about 6 GB.
MemoryMax=4G
Environment=NODE_OPTIONS=--max-old-space-size=2048
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
