[Unit]
Description=japharsworld-yt STAGING relay worker (#160; outbound only: long-polls staging-yt.eiok.cc, never listens)
After=network-online.target
Wants=network-online.target

[Service]
User=jytrelay
Group=jytrelay
WorkingDirectory=/opt/japharsworld-yt-relay-staging
EnvironmentFile=/etc/japharsworld-yt-relay-staging.env
ExecStart=/usr/bin/node /opt/japharsworld-yt-relay-staging/relay/worker.js
# The worker's cache of finished home relay streams (relay/cache.js), writable despite ProtectSystem=strict. A bigger
# volume can be mounted at /var/cache/japharsworld-yt-relay (README, home relay cache).
CacheDirectory=japharsworld-yt-relay-staging
Restart=always
RestartSec=5
# Kept at 300M on purpose (Everything-is-OK#968, 2026-11-21), below production's 4G with its 2 GB heap: the staging worker
# should run short of memory first. Node sizes its heap from this cap (about 150 MB, inferred): an ordinary caption info
# JSON (about 7 MB, about 24 MB to parse) fits, but one near INFO_MAX_BYTES (40 MB in src/captions.js, about 140 MB to
# parse) may not, so a staging crash on such a file is staging's, not a sign for production. The cgroup counts the
# stream cache's page cache too.
MemoryMax=300M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
