   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "max(eiok_home_today{key=\"workers\"}) < 1",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
  "uid": "eiok-credits-pace",
  "title": "Credits run out before renewal",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "60m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "At the last 3 days’ spend, the Tunelio credits run out before the plan renews on the 1st (the pacer then keeps plays at 720p; at 0 they go to youtube.com)."
  },
  "labels": {
   "project": "everything-is-ok"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "(sum(increase(eiok_events_total{metric=\"credits\"}[3d])) / 3) * (days_in_month() - day_of_month() + 1) - max(eiok_credits_remaining) > 0",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
