HOST=127.0.0.1
PORT=8790
SHARDS=8
POOL=2000
PIN_HOURS=24
DB_PATH=/var/lib/japharsworld-yt/tickets.db
YTDLP=/opt/japharsworld-yt-venv/bin/yt-dlp
YTDLP_ARGS=--js-runtimes node
# Optional: a routed IPv6 /64 of your own; yt-dlp then sends each lookup from a random address in it.
# SOURCE_IPV6_PREFIX=2600:db8:1234:5678::/64
# BLOCKED_MINUTES=10
# Tunelio (https://tunelio.dev): HD playback of ordinary videos and captions with every track a video has.
# Without a key, played tickets go to youtube.com (360p in VRChat) and captions use yt-dlp.
# TUNELIO_API_KEY=tnl_...
# TUNELIO_QUALITY=720p
# What a room may pick on its tablet (/v1/<shard>/q/<720|1080>), and how long a pick lasts.
# TUNELIO_QUALITIES=720p,1080p
# QUALITY_HOURS=12
# Playback plans (src/adaptive.js): 1080p at once when its build is predicted to take at most ADAPTIVE_DIRECT_SECONDS,
# else 720p stepping up to 1080p over adaptive HLS, paced to keep ADAPTIVE_RESERVE credits at renewal. Off by default;
# ADAPTIVE_SHARDS limits it to some shards while it is tried (empty = all).
# ADAPTIVE_HLS=off
# ADAPTIVE_SHARDS=
# ADAPTIVE_DIRECT_SECONDS=10
# How long a still-building upper rung's playlist is held before 404 (8 stalled AVPro's lower rung every 8 s, 2026-10-23).
# ADAPTIVE_HOLD_SECONDS=1
# The mid-video 720p → 1080p step up (froze the picture in 2 of 4 PC tries, 2026-10-22): off = a slow 1080p means 720p.
# ADAPTIVE_SWITCH=off
# A quick first rung (needs ADAPTIVE_SWITCH=on): when the 720p HLS build is predicted to take more than
# ADAPTIVE_START_SECONDS, start on a 360p HLS build and step up to 1080p, through 720p for big videos (30 credits instead of 20). Empty = off.
# ADAPTIVE_START=
# ADAPTIVE_START_SECONDS=10
# on: a start play always steps 360p → 720p → 1080p. off (default): 360p → 1080p, one switch, when the 1080p build is
# predicted ready within ADAPTIVE_START_STEP_SECONDS of the play starting; slower, 360p → 720p → 1080p.
# ADAPTIVE_START_MID=off
# ADAPTIVE_START_STEP_SECONDS=30
# ADAPTIVE_RESERVE=5000
# PUBLIC_URL=https://yt.japharsworld.com
# TUNELIO_PROGRESSIVE_MAX_MINUTES=720
# Above TUNELIO_MAX_MB a 1080p file is made again at TUNELIO_LOWER_QUALITY; above TUNELIO_PROGRESSIVE_MAX_MB (or
# longer than TUNELIO_PROGRESSIVE_MAX_MINUTES) it is served as HLS. Raised from 1800 MB / 180 min on 2026-10-27: Tunelio
# streams progressive files before the build ends since 2026-10-25, and HLS waits for the whole build (fails at ~125 s).
# TUNELIO_LOWER_QUALITY=720p
# TUNELIO_MAX_MB=1500
# TUNELIO_PROGRESSIVE_MAX_MB=6000
# Longest video played, in hours: over it, too_long on every platform with no Tunelio or home spend, and search doesn't
# list it. Live streams exempt.
# Only 0 turns it off; empty or garbage keeps the default.
# VIDEO_MAX_HOURS=12
# How long a video ticket keeps VRChat's resolver / the player waiting for a build (README, "Start-up latency").
# TICKET_RESOLVER_HOLD_SECONDS=12
# TICKET_PLAYER_HOLD_SECONDS=90
# TUNELIO_LOW_CREDITS=5000
# Day of the month the Tunelio plan renews (credits refresh); the metrics forecast and renewal reminders use it.
# TUNELIO_RENEWS_DAY=1
# Tunelio speed probe (src/probe.js): one fresh 12–30 min video every N minutes (at least 20), 10 credits each
# (~720 a day at 20). 0 = off.
# TUNELIO_PROBE_MINUTES=60
# TUNELIO_PROBE_QUALITY=1080p
# Player test slot refills a day via POST /ops/slots/refill (VRPlayer TEST world; 20 credits each; 0 = off)
# SLOT_REFILLS_PER_DAY=6
# CAPTION_SCRIPTS=Latn,Cyrl,Hans,Hant,Jpan,Kore,Thai,Hebr
# on: caption tracks without real word timing (uploader tracks, Tunelio) send no word offsets, so the world shows
# them with no spoken-word highlight (world #260; turn on together with the world update that hides the note).
# CAPTION_REAL_WORDS_ONLY=off
# Discord webhook for alerts (can be the Channels monitor's webhook).
# ALERT_WEBHOOK=https://discord.com/api/webhooks/...
# Search relay (README, "Search relay"): workers at home long-poll /relay/next with this token. openssl rand -hex 32
# RELAY_TOKEN=
# RELAY_WAIT_MS=8000
# RELAY_IDLE_ALERT_MINUTES=10
# Home relay playback (README, "Home relay playback"): a relay worker with ffmpeg streams videos from home as HLS
# when today's Tunelio credits are past the pacer's allowance, Tunelio is off or failing, or the video is
# HOME_LONG_MINUTES or longer. PC players only. The daily cap limits what the home IP downloads.
# HOME_RELAY=off
# Home relay for .m3u8 tickets too (the world's Android build), by the same rules, and for AV1 Tunelio builds the
# Quest 2 can't decode. Off until verified on the Quest.
# HOME_ANDROID=off
# .m3u8 tickets keep a growing home playlist instead of the uneven-keyframes give-up to Tunelio (world #250, testing).
# HOME_ANDROID_GROWING=off
# One source per ticket once playing (#293): a ticket's answer is kept per client kind while it is played (the video's
# length plus the margin after its last play), unless that source died; a youtube.com fallback is never kept.
# TICKET_PIN=off
# A pasted link's lookup (the tablet's load of the search address with a YouTube link) also warms the video, in the
# route's format: the .m3u8 address (or an Android User-Agent) as a Quest, else as a PC (Everything-is-OK#449). Same
# rules as a tablet's warm: no restricted or over-cap video, a cached build costs nothing.
# LOOKUP_WARM=on
# Caps on uncached lookup warms (each a paid Tunelio build) per minute, per IP and in all; over them the lookup is
# answered with no warm (warm_skip skipped cap). Cached builds and home builds don't count.
# LOOKUP_WARMS_PER_MINUTE_PER_IP=3
# LOOKUP_WARMS_PER_MINUTE=10
# Spend limits on paid Tunelio builds (src/spend.js, sized to a 100k credits a month plan): credits per rolling hour,
# 24 h and billing period (TUNELIO_RENEWS_DAY; 0 = no limit), and new paid builds a minute per client IP and per shard.
# Over one: no new build, the play goes home or to youtube.com. Past SPEND_HOME_FIRST_PERCENT of the hour or day
# budget, new plays go home first while home has a free stream.
# SPEND_HOUR_CREDITS=1500
# SPEND_DAY_CREDITS=8000
# SPEND_MONTH_CREDITS=100000
# SPEND_HOME_FIRST_PERCENT=75
# SPEND_BUILDS_PER_MINUTE_PER_IP=6
# SPEND_BUILDS_PER_MINUTE_PER_SHARD=12
# Ticket requests a minute per client IP (status, player, sheet, More); over it 429 rate_limited. More pages also count
# against SEARCHES_PER_MINUTE.
# TICKETS_PER_MINUTE_PER_IP=120
# Uncached caption transcripts a minute per client IP, under the same budget; over it captions are unavailable for now.
# SPEND_TRANSCRIPTS_PER_MINUTE_PER_IP=6
# Most client IPs kept by each per-IP limit; past it the least recently active go first.
# RATE_KEYS_MAX=10000
# Trusted client IPs, comma-separated IPv4, IPv6 or CIDR (the owner's home network: tests, the desk Quest, test
# clients). Every per-IP limit (SEARCHES_PER_MINUTE, TICKETS_PER_MINUTE_PER_IP, LOOKUP_WARMS_PER_MINUTE_PER_IP, SPEND_BUILDS_PER_MINUTE_PER_IP,
# SPEND_TRANSCRIPTS_PER_MINUTE_PER_IP) is TRUSTED_IP_FACTOR times as high for them; the per-shard cap, the global
# lookup-warm cap and the spend budget stay the same. Env only, never in the repo. Read at start: restart after a change.
# TRUSTED_IPS=
# TRUSTED_IP_FACTOR=10
# A .m3u8 ticket's Tunelio build still running after this many seconds also starts home; the player gets whichever is
# ready first (Everything-is-OK#398). 0 = off. Needs HOME_ANDROID=on and HOME_ANDROID_GROWING=on (without it a growing
# playlist has no start marker, and a Quest opens it at the live edge). Leave off until the fix for #393 is out.
# HOME_RACE_SECONDS=0
# TICKET_PIN_MARGIN_MINUTES=15
# Hold a player for a growing home playlist that is due to finish within this many seconds (it then starts at 0).
# HOME_SETTLE_SECONDS=10
# Tunelio's /create timeout, and how long after a Tunelio timeout plays go home instead (when they can).
# TUNELIO_CREATE_TIMEOUT_SECONDS=6
# TUNELIO_SUSPECT_SECONDS=120
# Tunelio builds running at once past which new plays go home first while home has a free stream (0 = never).
# TUNELIO_BUSY_BUILDS=8
# HOME_LONG_MINUTES=30
# What home builds when the room hasn't picked a quality (a room's own pick wins).
# HOME_QUALITY=1080p
# Home builds and MB downloaded from YouTube a day (the METRICS_TZ day, kept across restarts in home/day.json).
# HOME_DAILY_BUILDS=40
# HOME_DAILY_MB=50000
# HOME_KEEP_HOURS=12
# The size cap on the Linode's home session files: the oldest finished ones go first, never one building or being played.
# A build counts its expected final size from its start, so the cap holds while it grows (2026-10-28).
# HOME_MAX_GB=8
# Free disk (GB) home builds never take: a build that would leave less (after what running builds will still grow) doesn't
# start, and one running is stopped below half of it (2026-10-30: two long 1080p plays filled the Linode's disk; 0 = off).
# HOME_FREE_FLOOR_GB=3
# A home build expected over this size at 1080p (length × ~0.57 MB/s) is built at 720p instead (default HOME_MAX_GB; 0 = off).
# HOME_ITEM_MAX_GB=8
# HOME_READY_SECONDS=40
# HOME_SEGMENT_HOLD_SECONDS=20
# YouTube Data API v3 key (restricted to that API): last fallback for search, 101 units a search of 10,000 a day.
# YOUTUBE_API_KEY=
# YOUTUBE_API_DAILY_UNITS=10000
# Usage metrics (claude/metrics.md): SQLite file shared with the poller (empty = off), report time zone, /stats token.
# metrics-setup.sh adds METRICS_DB and a random STATS_TOKEN.
# METRICS_DB=/var/lib/japharsworld-yt/metrics.db
# METRICS_TZ=America/Chicago
# STATS_TOKEN=
# Where GET /feedback (eiok.cc/feedback) sends visitors with a 301; the default is the world's Google Form. Empty = 404.
# FEEDBACK_URL=https://docs.google.com/forms/d/1UXMXbqXXXtClqTAnQAVKA1niKKsIdOLMGjCPCH-yZFA/viewform
