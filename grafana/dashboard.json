{
 "uid": "everything-is-ok",
 "title": "Everything is OK",
 "tags": [
  "everything-is-ok"
 ],
 "timezone": "America/Chicago",
 "refresh": "5m",
 "time": {
  "from": "now-2d",
  "to": "now"
 },
 "schemaVersion": 39,
 "editable": true,
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "regex": ".*-prom$",
    "current": {}
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "name": "Annotations & Alerts",
    "type": "dashboard",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)"
   },
   {
    "name": "World uploads",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "enable": true,
    "iconColor": "#bb9af7",
    "expr": "max by (source, version) (eiok_release_timestamp_seconds{source=~\"world:.*\"}) * 1000",
    "step": "5m",
    "useValueForTime": true,
    "titleFormat": "{{source}} v{{version}}",
    "textFormat": "",
    "tagKeys": "source"
   },
   {
    "name": "GitHub releases",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "enable": true,
    "iconColor": "#7dcfff",
    "expr": "max by (source, version) (eiok_release_timestamp_seconds{source!~\"world:.*\"}) * 1000",
    "step": "5m",
    "useValueForTime": true,
    "titleFormat": "{{source}} {{version}}",
    "textFormat": "",
    "tagKeys": "source"
   },
   {
    "name": "Deploys",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "enable": true,
    "iconColor": "#e0af68",
    "expr": "max by (host, commit, outcome) (eiok_deploy_timestamp_seconds) * 1000",
    "step": "5m",
    "useValueForTime": true,
    "titleFormat": "{{host}} {{commit}} ({{outcome}})",
    "textFormat": "",
    "tagKeys": "host,outcome"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "id": 1,
   "title": "Now",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "id": 2,
   "title": "Search service",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "min(eiok_search_up)",
     "legendFormat": "",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "down",
         "color": "#f7768e"
        },
        "1": {
         "text": "up",
         "color": "#9ece6a"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#f7768e",
        "value": null
       },
       {
        "color": "#9ece6a",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "id": 3,
   "title": "Public /healthz",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 3,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "min(probe_success{job=~\".*search-healthz.*\"})",
     "legendFormat": "",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "down",
         "color": "#f7768e"
        },
        "1": {
         "text": "up",
         "color": "#9ece6a"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#f7768e",
        "value": null
       },
       {
        "color": "#9ece6a",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "id": 4,
   "title": "Relay workers",
   "description": "The Optiplex long-polling for searches.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "max(eiok_relay_workers_online)",
     "legendFormat": "",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#f7768e",
        "value": null
       },
       {
        "color": "#9ece6a",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "id": 5,
   "title": "In the world now",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 9,
