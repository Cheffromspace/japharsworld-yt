 {
  "uid": "eiok-disk-low",
  "title": "Disk almost full",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "15m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "Under 10 % free on / of {{ $labels.host }}."
  },
  "labels": {
   "project": "everything-is-ok"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "max by (host) (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) > 0.9",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 }
