 {
  "uid": "eiok-domain-check-stale",
  "title": "Domain expiry check failing",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "60m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "No good RDAP answer for a domain in 3 days (or never): the expiry alerts are blind. See `journalctl -u japharsworld-yt-metrics | grep domain_` on the Linode."
  },
  "labels": {
   "project": "everything-is-ok",
   "severity": "warning"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "(time() - max by (source) (eiok_poll_timestamp_seconds{env!=\"staging\",source=~\"domain:.*\"})) > 3 * 86400 or absent(eiok_poll_timestamp_seconds{env!=\"staging\",source=\"domain:eiok.cc\"}) or absent(eiok_poll_timestamp_seconds{env!=\"staging\",source=\"domain:japharsworld.com\"})",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
  "uid": "eiok-worker-not-serving",
  "title": "Searches not served by the home relay",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "5m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "The home relay worker is online, but over half of the last 30 minutes’ searches (3 or more) were served by the Linode or the Data API: YouTube may be refusing the home IP (see YouTube refusals)."
  },
  "labels": {
   "project": "everything-is-ok",
   "severity": "warning"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "(1 - (sum(increase(eiok_events_total{env!=\"staging\",metric=\"search_source\",key=\"worker\"}[30m])) or vector(0)) / sum(increase(eiok_events_total{env!=\"staging\",metric=\"search_source\"}[30m]))) > 0.5 and on() sum(increase(eiok_events_total{env!=\"staging\",metric=\"search_source\"}[30m])) >= 3 and on() max(eiok_relay_workers_online{env!=\"staging\"}) > 0",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
  "uid": "eiok-captions-paid",
  "title": "Captions falling back to Tunelio",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "30m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "Over the last 6 hours Tunelio (credits, segment timing) answered more caption fetches than the free sources (home relay, yt-dlp): YouTube may be refusing caption requests (see YouTube refusals)."
  },
  "labels": {
   "project": "everything-is-ok",
   "severity": "warning"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "sum(increase(eiok_events_total{env!=\"staging\",metric=\"cc_via\",key=\"tunelio\"}[6h])) - (sum(increase(eiok_events_total{env!=\"staging\",metric=\"cc_via\",key=~\"worker|local\"}[6h])) or vector(0)) > 0 and on() sum(increase(eiok_events_total{env!=\"staging\",metric=\"cc_via\",key=\"tunelio\"}[6h])) >= 3",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
  "uid": "eiok-channels-mass-down",
  "title": "Many Channels slots down or hidden",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "10m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "8 or more of the world's shown Channels slots are down or hidden at once (YouTube, the monitor or its worker)."
  },
  "labels": {
   "project": "everything-is-ok",
   "severity": "critical"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "sum(eiok_slot_hidden{env!=\"staging\"} * on(slot) (1 - eiok_slot_spare{env!=\"staging\"})) - 7",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
  "uid": "eiok-flash-refusals",
  "title": "Flash checks refused by YouTube",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "0m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "The Optiplex flash-check worker met 3 or more YouTube refusals (bot wall, rate limit, PO token or 403) in 30 minutes: the home IP may be flagged, which hits the relay worker too. Check `journalctl -u japharsworld-yt-slotworker` on the Optiplex."
  },
  "labels": {
   "project": "everything-is-ok",
   "severity": "warning"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "sum(increase(eiok_events_total{env!=\"staging\",metric=\"yt_refusal\",key=~\"flash:(bot|rate|potoken|forbidden)\"}[30m])) - 2",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
  "uid": "eiok-checks-waiting",
  "title": "Flash checks waiting",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "5m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "A new/candidate/manual resolution or flash job has waited over 2 hours, or the daily batch over 5 hours; the Optiplex worker runs every 20 minutes, 6 jobs a run."
  },
  "labels": {
   "project": "everything-is-ok",
   "severity": "warning"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "max(eiok_jobs_oldest_pending_seconds{env!=\"staging\",reason=\"other\"}) > 7200 or max(eiok_jobs_oldest_pending_seconds{env!=\"staging\",reason=\"daily\"}) > 18000",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
  "uid": "eiok-home-cap",
  "title": "Home relay near its daily cap",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "5m",
  "noDataState": "OK",
  "execErrState": "Error",
  "annotations": {
   "summary": "The home relay has used 90 % of HOME_DAILY_MB today; at the cap, long videos go to Tunelio (credits) or youtube.com instead."
  },
  "labels": {
   "project": "everything-is-ok",
   "severity": "warning"
  },
  "notification_settings": {
   "receiver": "Everything is OK Discord"
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 900,
     "to": 0
    },
    "datasourceUid": "${ds}",
    "model": {
     "refId": "A",
     "expr": "max(eiok_home_today{env!=\"staging\",key=\"mb\"}) / max(eiok_home_today{env!=\"staging\",key=\"cap_mb\"}) >= 0.9",
     "instant": true
    }
   },
   {
    "refId": "C",
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         0
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
  "uid": "eiok-home-worker",
  "title": "Home relay has no worker",
  "folderUID": "everything-is-ok",
  "ruleGroup": "everything-is-ok",
  "condition": "C",
  "for": "15m",
