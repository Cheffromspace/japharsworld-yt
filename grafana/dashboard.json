   }
  },
  {
   "type": "stat",
   "id": 11,
   "title": "Favorites (production)",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 5,
    "y": 5,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
